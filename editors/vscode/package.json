{
  "name": "forge-vscode-local",
  "displayName": "Forge",
  "description": "Use the local Forge coding agent from VS Code.",
  "version": "0.1.0",
  "publisher": "forge-local",
  "private": true,
  "license": "GPL-3.0-only",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "activationEvents": [
    "onCommand:forge.openChat"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "forge.openChat",
        "title": "Forge: Open Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "forge.newSession",
        "title": "Forge: New Session"
      },
      {
        "command": "forge.stopSession",
        "title": "Forge: Stop Current Turn"
      }
    ],
    "menus": {
      "commandPalette": [
        { "command": "forge.openChat" },
        { "command": "forge.newSession" },
        { "command": "forge.stopSession" }
      ]
    },
    "configuration": {
      "title": "Forge",
      "properties": {
        "forge.executablePath": {
          "type": "string",
          "default": "forge",
          "description": "Path to the Forge executable. Defaults to resolving 'forge' from PATH."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "vscode:prepublish": "npm run compile",
    "test": "npm run compile && node --test out/acpProtocol.test.js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
